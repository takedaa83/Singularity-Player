{
  "name": "singularity-player-monorepo",
  "version": "2.0.1",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "main": "electron/main.js",
  "scripts": {
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:desktop": "cross-env NODE_ENV=development VITE_DEV_SERVER=true concurrently \"npm run dev:server\" \"npm run dev:client\" \"wait-on http://localhost:5173 && electron .\"",
    "desktop:start": "electron .",
    "build:client": "npm run build --workspace=client",
    "build:server": "npm run build --workspace=server",
    "build": "npm run build:server && npm run build:client",
    "build:desktop": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "start": "npm start --workspace=server",
    "lint": "npm run lint --workspace=client",
    "test": "echo \"No tests defined\""
  },
  "dependencies": {
    "archiver": "^6.0.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "multer": "^1.4.5-lts.1",
    "music-metadata": "7.14.0",
    "undici": "^6.19.8"
  },
  "build": {
    "appId": "com.singularity.musicplayer",
    "productName": "Singularity Player",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "client/dist/**/*",
      "server/dist/**/*",
      "server/data/**/*",
      "build/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "client/dist/**/*",
      "server/dist/**/*",
      "server/data/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Singularity Player",
      "installerIcon": "build/installerIcon.ico",
      "uninstallerIcon": "build/uninstallerIcon.ico",
      "installerHeaderIcon": "build/installerIcon.ico"
    }
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3",
    "wait-on": "^9.1.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-android-arm64": "1.0.3",
    "@rolldown/binding-linux-x64-gnu": "^1.0.0",
    "@tailwindcss/oxide-android-arm64": "^4.0.0",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.0.0",
    "lightningcss-android-arm64": "^1.29.0",
    "lightningcss-linux-x64-gnu": "^1.29.0"
  }
}
